# Copilot Studio > Channels > Mobile app > Token Endpoint
# Publish the agent with Authentication set to No authentication.
COPILOTSTUDIOAGENT__TOKENENDPOINT=""

# Optional local semantic-routing model. Install Ollama separately and run:
# ollama pull qwen2.5:3b
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

# Optional local web-server settings
BURSAIQ_HOST="127.0.0.1"
BURSAIQ_PORT="5000"
